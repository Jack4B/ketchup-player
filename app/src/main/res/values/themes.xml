<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ketchup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ketchup_bg</item>
    </style>

    <!-- Splash (SplashScreen API, core-splashscreen): sygnet na #111217, bez osobnej Activity -->
    <style name="Theme.Ketchup.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ketchup</item>
    </style>
</resources>
