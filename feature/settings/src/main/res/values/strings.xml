    <string name="metadata_title">Oceny i opisy</string>
    <string name="metadata_intro">Oceny i opisy po polsku pobieramy z TMDB, OMDb, MDBList i Traktu. IMDb i Rotten Tomatoes nie mają własnych publicznych API: ich oceny dają OMDb i MDBList. Wpisz tyle darmowych kluczy, ile chcesz (wystarczy jeden).</string>
    <string name="metadata_tmdb_field">Klucz TMDB (opisy, obsada, ocena TMDB)</string>
    <string name="metadata_tmdb_hint">TMDB: themoviedb.org, konto, potem Ustawienia → API: wklej „API Key” albo „API Read Access Token” (oba działają).</string>
    <string name="metadata_omdb_field">Klucz OMDb (IMDb, Rotten Tomatoes, Metacritic)</string>
    <string name="metadata_omdb_hint">OMDb: omdbapi.com/apikey.aspx, klucz przychodzi na e-mail (1000 zapytań dziennie).</string>
    <string name="metadata_mdblist_field">Klucz MDBList (IMDb, Rotten Tomatoes, Metacritic, Trakt naraz)</string>
    <string name="metadata_mdblist_hint">MDBList: mdblist.com, konto, Preferences → API key (1000 zapytań dziennie).</string>
    <string name="metadata_trakt_field">Client ID Trakt (ocena Trakt, opis po polsku)</string>
    <string name="metadata_trakt_hint">Trakt: trakt.tv/oauth/applications, nowa aplikacja (adres zwrotny urn:ietf:wg:oauth:2.0:oob), skopiuj Client ID.</string>
